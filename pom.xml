<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.swp391.g1</groupId>
    <artifactId>swp391-g1</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SWP391-G1</name>
    <description>SWP391 (Group 1) - Common Spring Boot template codebase for the team project.</description>

    <properties>
        <!-- Java 21 LTS -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!--
            Spring MVC (web layer).
            Brings Spring MVC controllers, the embedded Tomcat web server,
            request/data binding and Jackson for (de)serialisation.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Thymeleaf: server-side HTML rendering for Spring MVC.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
            Spring Data JPA + Hibernate ORM: persistence layer.
            Also brings the JDBC infrastructure (DataSource, transaction manager).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Microsoft JDBC Driver for Microsoft SQL Server.
            The version is managed by Spring Boot's dependency management
            (spring-boot-dependencies), so no explicit version is needed here.
        -->
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
        </dependency>

        <!--
            Test stack: JUnit 5 (Jupiter), Spring Boot Test, AssertJ, Mockito.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
