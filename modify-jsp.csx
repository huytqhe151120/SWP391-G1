using System; using System.IO; using System.Text; public class JspModifier { public static void Main() { var path = @"src/main/webapp/WEB-INF/views/activity-series/list.jsp"; var c = File.ReadAllText(path); c = c.Replace("<th>M\u00e3 chu\u1ed9i</th>", "<th class=\"series-expand-col\"></th>\n                    <th>M\u00e3 chu\u1ed9i</th>"); c = c.Replace("<tr>\n                        <td><c:out value=\"${s.seriesCode}\"/></td>", "<tr class=\"series-parent-row\" data-series-id=\"${s.id}\" data-expanded=\"false\">\n                        <td class=\"series-expand-cell\"><button type=\"button\" class=\"series-expand-btn\" aria-expanded=\"false\" aria-label=\"M\u1ed9 m\u1ed9 r\u1ed9ng chi ti\u1ebft chu\u1ed9i ${s.seriesCode}\" data-series-id=\"${s.id}\"><span class=\"chevron\">\u25B8</span></button></td>\n                        <td><c:out value=\"${s.seriesCode}\"/></td>"); c = c.Replace("                    </tr>\n                </c:forEach>", "                    </tr>\n                    <tr class=\"series-child-row\" data-series-id=\"${s.id}\" style=\"display:none;\">\n                        <td colspan=\"9\">\n                            <div class=\"series-child-container\" id=\"series-child-${s.id}\">\n                                <div class=\"series-loading\" id=\"series-loading-${s.id}\" style=\"display:none;\"><span class=\"loading-spinner\"></span><span>\u0110ang t\u1ea3i...</span></div>\n                                <div class=\"series-error\" id=\"series-error-${s.id}\" style=\"display:none;\"><span class=\"error-text\"></span><button type=\"button\" class=\"button button-outline series-retry-btn\" data-series-id=\"${s.id}\">Th\u1eed l\u1ea1i</button></div>\n                                <div class=\"series-empty\" id=\"series-empty-${s.id}\" style=\"display:none;\"><p>Ch\u01b0a c\u00f3 s\u1ef1 ki\u1ec7n l\u1eadp l\u1ea1i n\u00e0o \u0111\u01b0\u01a1c \u0111\u01b0\u1ee3c t\u1ea1o.</p></div>\n                                <table class=\"activity-table occurrence-table\" id=\"occurrence-table-${s.id}\">\n                                    <thead>\n                                        <tr>\n                                            <th>M\u00e3</th>\n                                            <th>T\u00ean</th>\n                                            <th>Th\u1eddi gian b\u1eaft \u0111\u1ea7u</th>\n                                            <th>Th\u1eddi gian k\u00e9t th\u00fac</th>\n                                            <th>Tr\u1ea1ng th\u00e1i ho\u1ea1t \u0111\u1ed9ng</th>\n                                            <th>Tr\u1ea1ng th\u00e1i duy\u1ec7t</th>\n                                            <th class=\"activity-table-actions\">H\u00e0nh \u0111\u1ed9ng</th>\n                                        </tr>\n                                    </thead>\n                                    <tbody id=\"occurrence-body-${s.id}\">\n                                    </tbody>\n                                </table>\n                            </div>\n                        </td>\n                    </tr>\n                </c:forEach>"); File.WriteAllText(path, c, new UTF8Encoding(false)); Console.WriteLine("JSP modified"); } }
